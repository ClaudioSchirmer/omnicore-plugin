#!/usr/bin/env bash
# omnicore-gen — the plugin's code generator, on PATH.
#
# Everything in bin/ is added to PATH for the session, so the generator is a bare
# command wherever the session is: `omnicore-gen check -spec … -project .`. The
# alternative — teaching every skill to spell a path into the plugin cache — breaks
# the moment the cache directory changes, which it does on every update.
#
# It BUILDS and execs rather than `go run`-ing, for one reason that matters to a
# caller: `go run` reports a non-zero program exit as "exit status N" on stderr and
# exits 1 itself, so every failure looks identical. Building once and exec'ing the
# binary preserves the real exit code — and makes every later invocation instant.
set -euo pipefail

ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
SRC="$ROOT/gen"

if [[ ! -d "$SRC/cmd/omnicore-gen" ]]; then
  echo "omnicore-gen: the generator's source is not at $SRC — this plugin install is incomplete" >&2
  exit 127
fi

if ! command -v go >/dev/null 2>&1; then
  echo "omnicore-gen: needs a Go toolchain on PATH (the generator ships as source, not as a binary)" >&2
  exit 127
fi

# The build lands in the plugin's DATA dir, which survives plugin updates, and falls
# back to a temp dir when the variable is not set (running from a checkout).
CACHE="${CLAUDE_PLUGIN_DATA:-${TMPDIR:-/tmp}/omnicore-plugin-gen}"
mkdir -p "$CACHE"

# The binary is keyed by the plugin root, and that is what makes an UPDATE safe.
# The data dir survives updates by design, so yesterday's binary is still sitting
# there when today's source arrives — and the freshness check below is by mtime,
# which is only as trustworthy as whatever wrote the files. A cache dir that
# resolves the same before and after an update is how a session ends up running
# the OLD generator against the NEW skills, silently, which is the worst kind of
# wrong: everything answers, nothing is current.
#
# ${CLAUDE_PLUGIN_ROOT} changes on every update, so keying on it guarantees a
# fresh build per installed version while repeat calls within one version stay
# instant.
KEY=$(printf '%s' "$ROOT" | cksum | cut -d' ' -f1)
BIN="$CACHE/omnicore-gen-$KEY"

# Within one version, rebuild only when the source is newer: the common case is
# many calls in one session, and rebuilding each time would make `check` feel
# broken.
NEWEST=$(find "$SRC" -name '*.go' -newer "$BIN" -print -quit 2>/dev/null || true)
if [[ ! -x "$BIN" || -n "$NEWEST" ]]; then
  # GOWORK=off: a go.work in the surrounding tree would drag the service's own
  # modules into this build, which has nothing to do with them.
  if ! (cd "$SRC" && GOWORK=off go build -o "$BIN" ./cmd/omnicore-gen); then
    echo "omnicore-gen: the generator failed to build from $SRC" >&2
    exit 127
  fi
  # Previous versions' binaries, now unreachable: the data dir is ours and it
  # would otherwise grow one binary per update, forever.
  find "$CACHE" -maxdepth 1 -name 'omnicore-gen-*' ! -name "$(basename "$BIN")" -delete 2>/dev/null || true
fi

exec "$BIN" "$@"
